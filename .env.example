# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://trading_bot:trading_bot@localhost:5432/trading_bot?schema=public

# Trading safety: the safe default is paper mode. Do not change this casually.
TRADING_MODE=paper
MAX_ORDER_NOTIONAL_INR=5000
MAX_ORDERS_PER_RUN=5
DAILY_ORDER_CUTOFF_HOUR=14
ADMIN_TOKEN=replace-with-a-long-random-value

# Set only after the Kite adapter is implemented, reviewed and broker-approved.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Single-use and short-lived. After login redirect, paste request_token here and restart immediately.
# On success the access token is cached in .kite-session.json for later boots (until ~6 AM IST expiry).
KITE_REQUEST_TOKEN=

# Required in addition to credentials before any live execution code may run.
LIVE_TRADING_ACKNOWLEDGEMENT=

# Market-data session (WebSocket stream + interval snapshot logging)
SESSION_START_HOUR=9
SESSION_END_HOUR=15
SESSION_TICK_SECONDS=60
KITE_WS_MODE=quote
MAX_SESSION_INSTRUMENTS=20
SESSION_QUOTE_LOG_PATH=logs/session-quotes.jsonl

# Hugging Face Inference Providers (OpenAI-compatible router). Required at boot.
# Create a token with "Make calls to Inference Providers" at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
# Qwen3-32B:faster JSON/instruction follow than 14B:fastest; still :fastest routing for a 5–15m loop.
HF_MODEL=Qwen/Qwen3-32B:fastest
HF_TIMEOUT_MS=60000
HF_MAX_TOKENS=800

# LLM_PROVIDER=HF uses HF_* only. LLM_PROVIDER=GQ uses GROQ_* only.
LLM_PROVIDER=HF
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=60000
GROQ_MAX_TOKENS=800
# Only sent to reasoning models (openai/gpt-oss-*). Hidden reasoning counts against max tokens.
GROQ_REASONING_EFFORT=low

# Options decision loop: rules decide BUY/HOLD/EXIT/SKIP every N minutes while flat; the LLM only picks
# the strike. Decisions are stored, never executed. An open position is reviewed every minute (stops
# every 15 seconds) and sold by 15:15 IST.
LLM_DECISION_INTERVAL_MINUTES=5
LLM_MIN_HOLD_MINUTES=15
LLM_TARGET_NET_PNL_PCT=8
# Date-wise history of strategy enhancements suggested by POST /trading/session-review.
STRATEGY_LEDGER_PATH=data/strategy-enhancements.json
LLM_NEWS_LOOKBACK_DAYS=30
LLM_NEWS_ITEMS_PER_SYMBOL=8
TRADES_DIR=trades
UNIVERSE_DIR=universe
# Market-data JSON recorded per date by POST /api/v1/llm/simulate/decisions/start (reused on reruns).
SIMULATION_DIR=simulations
KITE_INSTRUMENTS_PATH=data/kite-instruments.json
KITE_INDEX_UNDERLYINGS_PATH=data/kite-index-underlyings.json
